<div id="main">
    <h1>Change Password</h1>
    
    {{#if error}}
    <div style="background: #f8d7da; color: #721c24; padding: 15px; margin-bottom: 20px; border-radius: 5px; border: 1px solid #f5c6cb;">
        <strong>Error:</strong> {{error}}
        {{#if details}}
        <br>{{details}}
        {{/if}}
    </div>
    {{/if}}
    
    {{#if success}}
    <div style="background: #d4edda; color: #155724; padding: 15px; margin-bottom: 20px; border-radius: 5px; border: 1px solid #c3e6cb;">
        <strong>Success:</strong> {{success}}
    </div>
    {{/if}}
    
    <div style="background: #f5f5f5; padding: 20px; border-radius: 5px; max-width: 600px;">
        <form method="POST" action="/change-password">
            <div style="margin-bottom: 20px;">
                <label for="securityQuestion" style="display: block; margin-bottom: 5px; font-weight: bold;">Security Question</label>
                <input type="text" id="securityQuestion" name="securityQuestion" value="{{user.securityQuestion}}" readonly style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; background: #e9ecef; font-size: 14px;"/>
                <small style="color: #666; font-size: 12px;">Please answer your security question to verify your identity.</small>
            </div>
            
            <div style="margin-bottom: 20px;">
                <label for="securityAnswer" style="display: block; margin-bottom: 5px; font-weight: bold;">Security Answer *</label>
                <input type="text" id="securityAnswer" name="securityAnswer" required maxlength="100" style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px;"/>
            </div>
            
            <div style="margin-bottom: 20px;">
                <label for="newPassword" style="display: block; margin-bottom: 5px; font-weight: bold;">New Password *</label>
                <input type="password" id="newPassword" name="newPassword" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px;"/>
                <small style="color: #666; font-size: 12px;">Must be at least 8 characters with uppercase, lowercase, number, and special character.</small>
            </div>
            
            <div style="margin-bottom: 20px;">
                <label for="confirmPassword" style="display: block; margin-bottom: 5px; font-weight: bold;">Confirm New Password *</label>
                <input type="password" id="confirmPassword" name="confirmPassword" required style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px;"/>
            </div>
            
            <div style="display: flex; gap: 10px;">
                <button type="submit" style="background: #00667D; color: white; padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer; font-size: 16px; font-weight: bold;">
                    Change Password
                </button>
                <a href="/Profile" style="background: #999; color: white; padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer; font-size: 16px; text-decoration: none; display: inline-block;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

