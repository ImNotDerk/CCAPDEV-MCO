<!DOCTYPE html>
<html>
    <head>
        <title>Forgot Password - Lab Reservation</title>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="/css/loginpage.css" rel="stylesheet">
    </head>
    <body>
        <div class="main-container">
            <div class="form">
                <h2>Forgot Password</h2>
                <p style="color: #666; margin-bottom: 20px; text-align: center;">
                    Enter your email address to answer your security question and reset your password.
                </p>

                {{#if message}}
                <div class="message-box {{messageType}}" id="messageBox" style="padding: 15px; margin-bottom: 20px; border-radius: 5px; text-align: center;">
                    {{message}}
                </div>
                <script>
                    (function() {
                        const box = document.getElementById('messageBox');
                        if (box) {
                            const messageType = '{{messageType}}';
                            if (messageType === 'error') {
                                box.style.background = '#f8d7da';
                                box.style.color = '#721c24';
                                box.style.border = '1px solid #f5c6cb';
                            } else {
                                box.style.background = '#d1ecf1';
                                box.style.color = '#0c5460';
                                box.style.border = '1px solid #bee5eb';
                            }
                        }
                    })();
                </script>
                {{/if}}

                <form method="POST" action="/forgotpassword">
                    <input type="email" placeholder="Email Address *" name="email" required maxlength="100"/>
                    <button class="btn" type="submit">Continue</button>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </form>

                <p class="message">
                    <a href="/">Back to Login</a>
                </p>
            </div>
        </div>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    </body>
</html>

