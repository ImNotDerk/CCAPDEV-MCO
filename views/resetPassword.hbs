<!DOCTYPE html>
<html>
    <head>
        <title>Reset Password - Lab Reservation</title>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="/css/loginpage.css" rel="stylesheet">
    </head>
    <body>
        <div class="main-container">
            <div class="form">
                {{#if success}}
                <h2>Password Reset Successful</h2>
                <div class="message-box success" style="padding: 15px; margin-bottom: 20px; border-radius: 5px; text-align: center; background: #d4edda; color: #155724; border: 1px solid #c3e6cb;">
                    {{message}}
                </div>
                <p class="message">
                    <a href="/">Go to Login</a>
                </p>
                {{else}}
                <h2>Reset Password</h2>
                
                {{#if error}}
                <div class="message-box error" style="padding: 15px; margin-bottom: 20px; border-radius: 5px; text-align: center; background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;">
                    {{error}}
                </div>
                {{/if}}

                {{#if email}}
                <p style="color: #666; margin-bottom: 20px; text-align: center;">
                    Please enter your new password below.
                </p>

                <form method="POST" action="/reset-password">
                    <input type="hidden" name="email" value="{{email}}"/>
                    
                    <div class="password-container">
                        <input type="password" id="password" placeholder="New Password *" name="password" required/>
                        <div class="password-requirements" id="passwordRequirements">
                            <p class="requirements-title">Password must contain:</p>
                            <ul class="requirements-list">
                                <li id="req-length" class="requirement-item">
                                    <span class="req-icon">✗</span>
                                    <span>At least 8 characters</span>
                                </li>
                                <li id="req-uppercase" class="requirement-item">
                                    <span class="req-icon">✗</span>
                                    <span>One uppercase letter</span>
                                </li>
                                <li id="req-lowercase" class="requirement-item">
                                    <span class="req-icon">✗</span>
                                    <span>One lowercase letter</span>
                                </li>
                                <li id="req-number" class="requirement-item">
                                    <span class="req-icon">✗</span>
                                    <span>One number</span>
                                </li>
                                <li id="req-special" class="requirement-item">
                                    <span class="req-icon">✗</span>
                                    <span>One special character (!@#$%^&*()_+-=[]{}|;:,.<>?)</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="password-match-container">
                        <input type="password" id="password2" placeholder="Confirm New Password *" name="confirmPassword" required/>
                        <div class="password-match-message" id="passwordMatchMessage"></div>
                    </div>

                    <button class="btn" type="submit">Reset Password</button>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </form>
                <p class="message" style="margin-top: 15px;">
                    <a href="/">Back to Login</a>
                </p>
                {{else}}
                <p class="message">
                    <a href="/forgotpassword">Start over</a> | 
                    <a href="/">Back to Login</a>
                </p>
                {{/if}}
                {{/if}}
            </div>
        </div>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        {{#if email}}
        <script src="js/loginpage.js"></script>
        {{/if}}
    </body>
</html>

