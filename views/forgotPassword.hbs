<!DOCTYPE html>
<html>
    <head>
        <title>Forgot Password - Lab Reservation</title>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="/css/loginpage.css" rel="stylesheet">
    </head>
    <body>
        <div class="main-container">
            <div class="form">
                <h2>Forgot Password</h2>
                <p style="color: #666; margin-bottom: 20px; text-align: center;">
                    Enter your email address and we'll send you a link to reset your password.
                </p>

                {{#if message}}
                <div class="message-box {{messageType}}" style="padding: 15px; margin-bottom: 20px; border-radius: 5px; text-align: center;">
                    {{message}}
                    {{#if devResetLink}}
                    <br><br>
                    <small style="color: #00667D;">
                        <strong>Development Mode:</strong><br>
                        <a href="{{devResetLink}}" style="color: #00667D; word-break: break-all;">{{devResetLink}}</a>
                    </small>
                    {{/if}}
                </div>
                {{/if}}

                <form method="POST" action="/forgotpassword">
                    <input type="email" placeholder="Email Address *" name="email" required maxlength="100"/>
                    <button class="btn" type="submit">Send Reset Link</button>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </form>

                <p class="message">
                    <a href="/">Back to Login</a>
                </p>
            </div>
        </div>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    </body>
</html>

