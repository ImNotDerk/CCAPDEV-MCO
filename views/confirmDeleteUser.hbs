<div id="main">
    <h1>Confirm User Deletion</h1>
    
    <div style="background: #fff3cd; border: 2px solid #ffc107; padding: 20px; border-radius: 5px; margin-bottom: 20px;">
        <h2 style="color: #856404; margin-top: 0;">⚠️ Warning: This action cannot be undone!</h2>
        <p style="color: #856404; margin-bottom: 0;">
            You are about to permanently delete a user account. This action requires re-authentication for security.
        </p>
    </div>

    <div style="background: #f5f5f5; padding: 20px; border-radius: 5px; margin-bottom: 20px;">
        <h3>User to be deleted:</h3>
        <table style="width: 100%; border-collapse: collapse;">
            <tr>
                <td style="padding: 8px; font-weight: bold; width: 150px;">Name:</td>
                <td style="padding: 8px;">{{targetUser.fname}} {{targetUser.lname}}</td>
            </tr>
            <tr>
                <td style="padding: 8px; font-weight: bold;">ID Number:</td>
                <td style="padding: 8px;">{{targetUser.id}}</td>
            </tr>
            <tr>
                <td style="padding: 8px; font-weight: bold;">Email:</td>
                <td style="padding: 8px;">{{targetUser.email}}</td>
            </tr>
            <tr>
                <td style="padding: 8px; font-weight: bold;">Role:</td>
                <td style="padding: 8px;">
                    {{#if (eq targetUser.accountType "ADMINISTRATOR")}}
                        <span style="color: #d32f2f; font-weight: bold;">Administrator</span>
                    {{else if (eq targetUser.accountType "ROLE_A")}}
                        <span style="color: #1976d2; font-weight: bold;">Role A (Manager)</span>
                    {{else}}
                        <span style="color: #666;">Role B (Customer/Employee)</span>
                    {{/if}}
                </td>
            </tr>
        </table>
    </div>

    <div id="messageBox" style="display: none; padding: 15px; margin-bottom: 20px; border-radius: 5px;"></div>

    <form id="deleteUserForm" method="POST" action="/admin/users/{{targetUser._id}}/delete">
        <div style="background: #e3f2fd; border: 1px solid #2196f3; padding: 20px; border-radius: 5px; margin-bottom: 20px;">
            <h3 style="margin-top: 0; color: #1976d2;">Re-authentication Required</h3>
            <p style="color: #666; margin-bottom: 15px;">
                For security reasons, please enter your password to confirm this action.
            </p>
            <div>
                <label for="password" style="display: block; margin-bottom: 5px; font-weight: bold;">Your Password *</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    required 
                    autocomplete="current-password"
                    style="width: 100%; max-width: 400px; padding: 10px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px;"
                    placeholder="Enter your password to confirm"
                />
            </div>
        </div>

        <div style="display: flex; gap: 10px;">
            <button 
                type="submit" 
                class="edit-cancel-btn" 
                style="background: #d32f2f; color: white; padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer; font-size: 16px; font-weight: bold;"
            >
                Confirm Deletion
            </button>
            <a 
                href="/admin/users" 
                class="edit-cancel-btn" 
                style="background: #999; color: white; padding: 12px 24px; border: none; border-radius: 5px; cursor: pointer; font-size: 16px; text-decoration: none; display: inline-block;"
            >
                Cancel
            </a>
        </div>
    </form>
</div>

<script>
document.getElementById('deleteUserForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const passwordField = document.getElementById('password');
    const password = passwordField.value;
    
    if (!password || password.trim() === '') {
        const messageBox = document.getElementById('messageBox');
        messageBox.style.display = 'block';
        messageBox.style.background = '#f8d7da';
        messageBox.style.color = '#721c24';
        messageBox.style.border = '1px solid #f5c6cb';
        messageBox.textContent = 'Please enter your password.';
        return;
    }
    
    const messageBox = document.getElementById('messageBox');
    const submitButton = this.querySelector('button[type="submit"]');
    
    // Disable button during request
    submitButton.disabled = true;
    submitButton.textContent = 'Processing...';
    messageBox.style.display = 'none';
    
    // Use URLSearchParams to send as application/x-www-form-urlencoded
    const formData = new URLSearchParams();
    formData.append('password', password);
    
    try {
        const response = await fetch(this.action, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: formData
        });
        
        // Check if response is JSON
        const contentType = response.headers.get('content-type');
        let data;
        
        if (contentType && contentType.includes('application/json')) {
            data = await response.json();
        } else {
            // If not JSON, might be HTML error page
            const text = await response.text();
            console.error('Non-JSON response:', text.substring(0, 200));
            throw new Error('Unexpected response format');
        }
        
        // Check response status after parsing JSON
        if (!response.ok) {
            throw new Error(data.message || data.error || `Server error: ${response.status}`);
        }
        
        if (data.success) {
            messageBox.style.display = 'block';
            messageBox.style.background = '#d4edda';
            messageBox.style.color = '#155724';
            messageBox.style.border = '1px solid #c3e6cb';
            messageBox.textContent = data.message || 'User deleted successfully. Redirecting...';
            
            // Redirect after short delay
            setTimeout(() => {
                window.location.href = data.redirect || '/admin/users';
            }, 1500);
        } else {
            messageBox.style.display = 'block';
            messageBox.style.background = '#f8d7da';
            messageBox.style.color = '#721c24';
            messageBox.style.border = '1px solid #f5c6cb';
            messageBox.textContent = data.message || 'An error occurred while deleting the user.';
            
            // Re-enable button
            submitButton.disabled = false;
            submitButton.textContent = 'Confirm Deletion';
            
            // Clear password field if re-auth failed
            if (data.requiresReAuth) {
                document.getElementById('password').value = '';
                document.getElementById('password').focus();
            }
        }
    } catch (error) {
        console.error('Delete user error:', error);
        messageBox.style.display = 'block';
        messageBox.style.background = '#f8d7da';
        messageBox.style.color = '#721c24';
        messageBox.style.border = '1px solid #f5c6cb';
        messageBox.textContent = error.message || 'An error occurred. Please try again.';
        
        submitButton.disabled = false;
        submitButton.textContent = 'Confirm Deletion';
        
        // Clear password field on error
        document.getElementById('password').value = '';
    }
});
</script>

