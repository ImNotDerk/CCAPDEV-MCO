<!DOCTYPE html>
<html>
    <head>
        <title>Forgot Password - Security Question - Lab Reservation</title>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link href="/css/loginpage.css" rel="stylesheet">
    </head>
    <body>
        <div class="main-container">
            <div class="form">
                <h2>Answer Security Question</h2>
                <p style="color: #666; margin-bottom: 20px; text-align: center;">
                    Please answer your security question to reset your password.
                </p>

                {{#if error}}
                <div class="message-box error" style="padding: 15px; margin-bottom: 20px; border-radius: 5px; text-align: center; background: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;">
                    {{error}}
                </div>
                {{/if}}

                <form method="POST" action="/forgotpassword-verify">
                    <input type="hidden" name="email" value="{{email}}"/>
                    <input type="hidden" name="securityQuestion" value="{{securityQuestion}}"/>
                    
                    <div style="background: #e3f2fd; padding: 15px; margin-bottom: 20px; border-radius: 5px; border: 1px solid #2196f3;">
                        <label style="display: block; margin-bottom: 5px; font-weight: bold; color: #1976d2;">Security Question:</label>
                        <p style="color: #333; margin: 0;">{{securityQuestion}}</p>
                    </div>
                    
                    <input type="text" placeholder="Security Answer *" name="securityAnswer" required maxlength="100" autocomplete="off"/>
                    <button class="btn" type="submit">Verify Answer</button>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </form>

                <p class="message">
                    <a href="/forgotpassword">Back</a> | <a href="/">Back to Login</a>
                </p>
            </div>
        </div>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    </body>
</html>

